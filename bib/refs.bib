  author = {Song, Hyunjin and Tolochko, Petro and Eberl, Jakob-Moritz and Eisele, Olga and Greussing, Esther and Heidenreich, Tobias and Lind, Fabienne and Galyga, Sebastian and Boomgaarden, Hajo G.},
